+  [[inputs.opcua.nodes]]
+    name = "lowersensor.active"
+    namespace = "2"
+    identifier_type = "s"
+    identifier = "rtu-1.lowersensor.active"
+    default_tags = { rtu = "rtu-1", device = "lowersensor", field = "active" }
+
+  [[inputs.opcua.nodes]]
+    name = "lowersensor.direction"
+    namespace = "2"
+    identifier_type = "s"
+    identifier = "rtu-1.lowersensor.direction"
+    default_tags = { rtu = "rtu-1", device = "lowersensor", field = "direction" }
+
+  [[inputs.opcua.nodes]]
+    name = "lowervalve.open"
+    namespace = "2"
+    identifier_type = "s"
+    identifier = "rtu-1.lowervalve.open"
+    default_tags = { rtu = "rtu-1", device = "lowervalve", field = "open" }
