+# Telegraf config for the historian (injected to /etc/telegraf/telegraf.conf); token/org/bucket match influx-setup.sh.
+[agent]
+  interval = "5s"
+  round_interval = true
+  flush_interval = "10s"
+  omit_hostname = false
+
+[[inputs.opcua]]
+  name = "waterway"
+  endpoint = "opc.tcp://10.1.2.50:4840"
+  connect_timeout = "10s"
+  request_timeout = "5s"
+  security_policy = "None"
+  security_mode = "None"
+  auth_method = "Anonymous"
+
+  [[inputs.opcua.nodes]]
+    name = "boat.direction"
+    namespace = "2"
+    identifier_type = "s"
+    identifier = "rtu-1.boat.direction"
+    default_tags = { rtu = "rtu-1", device = "boat", field = "direction" }
+
+  [[inputs.opcua.nodes]]
+    name = "boat.location"
+    namespace = "2"
+    identifier_type = "s"
+    identifier = "rtu-1.boat.location"
+    default_tags = { rtu = "rtu-1", device = "boat", field = "location" }
+
+  [[inputs.opcua.nodes]]
+    name = "lock.height"
+    namespace = "2"
+    identifier_type = "s"
+    identifier = "rtu-1.lock.height"
+    default_tags = { rtu = "rtu-1", device = "lock", field = "height" }
+
+  [[inputs.opcua.nodes]]
+    name = "locksensor.active"
+    namespace = "2"
+    identifier_type = "s"
+    identifier = "rtu-1.locksensor.active"
+    default_tags = { rtu = "rtu-1", device = "locksensor", field = "active" }
+
+  [[inputs.opcua.nodes]]
+    name = "locksensor.direction"
+    namespace = "2"
+    identifier_type = "s"
+    identifier = "rtu-1.locksensor.direction"
+    default_tags = { rtu = "rtu-1", device = "locksensor", field = "direction" }
+
+  [[inputs.opcua.nodes]]
+    name = "lowergate.open"
+    namespace = "2"
+    identifier_type = "s"
+    identifier = "rtu-1.lowergate.open"
+    default_tags = { rtu = "rtu-1", device = "lowergate", field = "open" }
