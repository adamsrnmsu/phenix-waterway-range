NAME=minirouter-arm64
RELEASE=noble
VARIANT=minbase
MIRROR=http://ports.ubuntu.com/ubuntu-ports
PACKAGES="dnsmasq openvswitch-switch bird nano iptables nftables isc-dhcp-client isc-dhcp-common"
# absolute paths are used as-is (read-only upstream inputs); bare names resolve under images/scripts, images/overlays
SCRIPTS="${SCEPTRE_PHENIX_IMAGES:-$HOME/git/sceptre-phenix-images}/scripts/minirouter.sh"
OVERLAYS="${SCEPTRE_PHENIX_IMAGES:-$HOME/git/sceptre-phenix-images}/overlays/minirouter"
SIZE=10G
MINGUI=0
# 1 = also inject the arm64 minirouter binary (from the minimega container)
INJECT_MINIROUTER=1
